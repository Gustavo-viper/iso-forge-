#!/bin/sh
set -e

# Forge OS V1.1 branding and desktop defaults.
mkdir -p /etc/skel/Desktop /etc/skel/Forge/Projects /etc/skel/Forge/Games /etc/skel/Forge/SDKs /etc/skel/Forge/Downloads /usr/share/backgrounds/forge /etc/xdg/autostart
cp /usr/share/backgrounds/forge/forge-wallpaper.svg /etc/skel/forge-wallpaper.svg || true

# Make the installer visible on the live desktop.
if [ -d /etc/skel/Desktop ]; then
  cp /usr/share/applications/forge-installer.desktop /etc/skel/Desktop/Forge-OS-Installer.desktop
  chmod +x /etc/skel/Desktop/Forge-OS-Installer.desktop
fi

# Prefer NetworkManager for desktop networking.
systemctl enable NetworkManager.service 2>/dev/null || true

# Ensure the graphical session starts reliably in Live mode and after installation.
mkdir -p /etc/lightdm/lightdm.conf.d
cat > /etc/lightdm/lightdm.conf.d/50-forge.conf <<'EOF'
[Seat:*]
greeter-session=lightdm-gtk-greeter
greeter-hide-users=false
user-session=xfce
autologin-user=forge
autologin-user-timeout=0
autologin-session=xfce
EOF

# Provide an explicit XFCE fallback session.
cat > /etc/skel/.xsession <<'EOF'
#!/bin/sh
exec startxfce4
EOF
chmod +x /etc/skel/.xsession

# Register LightDM and graphical boot.
systemctl enable lightdm.service 2>/dev/null || true
ln -sf /lib/systemd/system/lightdm.service /etc/systemd/system/display-manager.service 2>/dev/null || true
systemctl set-default graphical.target 2>/dev/null || true

# Let Xorg auto-detect the GPU to avoid QEMU/real-hardware black screens.
rm -f /etc/X11/xorg.conf.d/20-forge-modesetting.conf 2>/dev/null || true

# The live Forge user can perform the first-boot application setup without
# interactive password prompts. The system still keeps normal sudo for users.
mkdir -p /etc/sudoers.d
cat > /etc/sudoers.d/forge-firstboot <<'EOF'
forge ALL=(root) NOPASSWD: /usr/local/bin/forge-install-steam
EOF
chmod 0440 /etc/sudoers.d/forge-firstboot

# The workflow places this script in /usr/local/bin before the hook runs.
chmod +x /usr/local/bin/forge-desktop-init.sh 2>/dev/null || true
cat > /etc/xdg/autostart/forge-desktop-init.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=Forge Desktop Initialization
Comment=Aplica o layout, tema e atalhos do Forge OS
Exec=/usr/local/bin/forge-desktop-init.sh
Terminal=false
OnlyShowIn=XFCE;
X-GNOME-Autostart-enabled=true
EOF

# Mark the V1.1 release in the installed system.
cat > /etc/forge-os-release <<'EOF'
FORGE_OS_VERSION="1.1"
FORGE_OS_CODENAME="V1.1 Gaming & Dev"
FORGE_OS_BASE="Debian 12 Bookworm"
EOF
