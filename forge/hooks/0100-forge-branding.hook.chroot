#!/bin/sh
set -e

# Forge OS branding and lightweight defaults.
mkdir -p /etc/skel/Desktop /usr/share/backgrounds/forge
cp /usr/share/backgrounds/forge/forge-wallpaper.svg /etc/skel/forge-wallpaper.svg || true

# Make the installer visible on the live desktop.
if [ -d /etc/skel/Desktop ]; then
  cp /usr/share/applications/forge-installer.desktop /etc/skel/Desktop/Forge-OS-Installer.desktop
  chmod +x /etc/skel/Desktop/Forge-OS-Installer.desktop
fi

# Prefer NetworkManager for desktop networking.
systemctl enable NetworkManager.service 2>/dev/null || true

# Ensure the graphical session is available in Live mode and after installation.
# Explicitly enable LightDM because task-xfce-desktop can otherwise leave the
# display manager selection dependent on package-install order.
mkdir -p /etc/lightdm/lightdm.conf.d
cat > /etc/lightdm/lightdm.conf.d/50-forge.conf <<'EOF'
[Seat:*]
greeter-session=lightdm-gtk-greeter
user-session=xfce
EOF

systemctl enable lightdm.service 2>/dev/null || true
systemctl set-default graphical.target 2>/dev/null || true

# Make Xorg use the generic modesetting driver when running under QEMU/virtio.
# This avoids a blank graphical session on virtual GPUs while preserving native
# GPU detection on physical hardware.
mkdir -p /etc/X11/xorg.conf.d
cat > /etc/X11/xorg.conf.d/20-forge-modesetting.conf <<'EOF'
Section "Device"
    Identifier "Forge Virtual/Generic GPU"
    Driver "modesetting"
    Option "AccelMethod" "glamor"
EndSection
EOF
